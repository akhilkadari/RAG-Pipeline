# ─── LLM provider keys ─────────────────────────────────────
# At minimum, set OPENAI_API_KEY. ANTHROPIC_API_KEY is optional.
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=

# ─── Model selection ───────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# ─── Index / data paths (relative to project root) ─────────
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
INDEX_DIR=data/index
CHROMA_COLLECTION=rag_chunks

# ─── Retrieval defaults ────────────────────────────────────
DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_DENSE_WEIGHT=0.7
RRF_SPARSE_WEIGHT=0.3
RRF_K_CONSTANT=60
RERANK_INPUT=20
RERANK_OUTPUT=5
DEDUP_THRESHOLD=0.95
CONFIDENCE_THRESHOLD=0.35

# ─── Chunking defaults ─────────────────────────────────────
DEFAULT_CHUNKER=recursive
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ─── API ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
