# Project data
# Keep raw uploads out of git so the repo stays small.
# Processed outputs and indexes are derived artifacts.
data/raw/*
!data/raw/.gitkeep
!data/raw/sample_corpus/
!data/raw/sample_corpus/**
data/processed/*
!data/processed/.gitkeep
data/index/
data/eval/last_run.json
data/eval/chunking_comparison.json
data/eval/chunking_comparison.md
